---
import PageTexte from '../components/PageTexte.astro';
import { SITE } from '../data/site';
---
<PageTexte title="Mentions légales | Garage Sport Auto, Groslay" description="Mentions légales du site du Garage Sport Auto, 24 rue de la Station à Groslay : éditeur, hébergeur, propriété intellectuelle." titre="Mentions légales">
  <h2>Éditeur du site</h2>
  <p>
    {SITE.nom}<br />
    {SITE.adresse.rue}, {SITE.adresse.cp} {SITE.adresse.ville}<br />
    Téléphone : <a href={`tel:${SITE.telLien}`}>{SITE.telAffiche}</a>
  </p>
  <ul>
    <li>Société exploitante (dénomination) : <span class="ac">[À CONFIRMER]</span></li>
    <li>Forme juridique et capital : <span class="ac">[À CONFIRMER]</span></li>
    <li>SIREN / SIRET : <span class="ac">[À CONFIRMER]</span></li>
    <li>RCS et numéro de TVA intracommunautaire : <span class="ac">[À CONFIRMER]</span></li>
    <li>Directeur de la publication : <span class="ac">[À CONFIRMER]</span></li>
    <li>Adresse e-mail de contact : <span class="ac">[À CONFIRMER]</span></li>
  </ul>

  <h2>Hébergeur</h2>
