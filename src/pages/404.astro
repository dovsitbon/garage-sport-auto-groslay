---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Page introuvable | Garage Sport Auto, Groslay" description="Cette page n'existe pas sur le site du Garage Sport Auto à Groslay." noindex>
  <section class="wrap py-16 md:py-24 grid md:grid-cols-[1fr_1fr] gap-10 items-center">
    <div>
      <p class="font-titre font-bold text-orange-fonce text-[1.1rem]">Erreur 404</p>
      <h1 class="mt-2 text-[2.4rem] md:text-[3.4rem]">Cette page n'existe pas.</h1>
      <p class="mt-4 text-[1.1rem]">L'adresse est peut-être mal tapée, ou la page a été retirée.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/" class="btn btn-orange">Retour à l'accueil</a>
        <a href={`tel:${SITE.telLien}`} class="btn btn-ligne">Appeler le {SITE.telAffiche}</a>
      </div>
    </div>
    <div class="feuille mr-2.5 mb-2.5 p-6" aria-hidden="true">
      <p class="etiquette">Constat</p>
      <p class="mt-1 font-titre font-bold text-[1.6rem]">Pièce introuvable</p>
      <p class="mt-3 ligne-ecrite pb-2">Référence demandée : inconnue</p>
      <p class="mt-3 ligne-ecrite pb-2">Action : retour à l'accueil</p>
    </div>
  </section>
</Base>
