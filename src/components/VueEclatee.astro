---
// Vue éclatée originale d'une ligne d'échappement (dessin SVG fait main, illustratif).
// Les pièces sont dessinées en position assemblée ; --dx / --dy les écartent (vue éclatée).
type Etat = 'garde' | 'remplace' | 'surveille';
const PIECES: { n: number; nom: string; etat: Etat; dx: number; dy: number; cx: number; ly: number; py: number }[] = [
  { n: 1, nom: 'Collecteur', etat: 'garde', dx: -30, dy: -60, cx: 65, ly: 40, py: 86 },
  { n: 2, nom: 'Joint de collecteur', etat: 'remplace', dx: -14, dy: 50, cx: 152, ly: 330, py: 276 },
  { n: 3, nom: 'Catalyseur', etat: 'garde', dx: 0, dy: -55, cx: 236, ly: 40, py: 106 },
  { n: 4, nom: 'Flexible', etat: 'remplace', dx: 16, dy: 50, cx: 347, ly: 330, py: 263 },
  { n: 5, nom: 'Tube et silencieux intermédiaire', etat: 'garde', dx: 32, dy: -50, cx: 509, ly: 40, py: 122 },
  { n: 6, nom: 'Collier de serrage', etat: 'garde', dx: 48, dy: 60, cx: 654, ly: 330, py: 278 },
  { n: 7, nom: 'Silencieux arrière', etat: 'garde', dx: 64, dy: -40, cx: 789, ly: 330, py: 212 },
  { n: 8, nom: 'Silentbloc de suspension', etat: 'surveille', dx: 64, dy: -64, cx: 900, ly: 40, py: 0 },
];
const ETATS: Record<Etat, string> = { garde: 'Conservé', remplace: 'À remplacer', surveille: 'À surveiller' };
const p = (n: number) => PIECES[n - 1];
const st = (n: number) => `--dx:${p(n).dx}px;--dy:${p(n).dy}px`;
---
<figure class="eclate feuille bg-blanc text-anthracite" data-eclate>
  <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Vue éclatée d'une ligne d'échappement, faire défiler horizontalement sur petit écran">
    <svg viewBox="0 0 960 380" class="block w-full min-w-[680px] h-auto" role="img" aria-labelledby="eclate-titre eclate-desc">
      <title id="eclate-titre">Vue éclatée d'une ligne d'échappement</title>
      <desc id="eclate-desc">Huit pièces numérotées, du collecteur au silencieux arrière. Dans cet exemple, seuls le joint de collecteur et le flexible sont à remplacer, le silentbloc est à surveiller, le reste est conservé.</desc>
      <defs>
        <pattern id="hachures" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="6" height="6" fill="#fdeee5" />
          <line x1="0" y1="0" x2="0" y2="6" stroke="#e2601b" stroke-width="2.4" />
        </pattern>
        <pattern id="quadrillage" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="#3d6e9e" stroke-opacity=".12" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="960" height="380" fill="url(#quadrillage)" />
      <!-- axe de la ligne -->
      <path d="M10 200H950" stroke="#3d6e9e" stroke-opacity=".55" stroke-width="1" stroke-dasharray="22 5 3 5" />

      <g class="piece" data-n="1" data-etat={p(1).etat} style={st(1)}>
        <rect class="c" x="40" y="150" width="12" height="100" />
        <circle class="c" cx="46" cy="160" r="3" /><circle class="c" cx="46" cy="240" r="3" />
        <path class="to" d="M52 166C92 166 112 192 150 195" /><path class="ti" d="M52 166C92 166 112 192 150 195" />
        <path class="to" d="M52 234C92 234 112 208 150 205" /><path class="ti" d="M52 234C92 234 112 208 150 205" />
        <path class="to" d="M52 200H150" /><path class="ti" d="M52 200H150" />
        <rect class="c" x="148" y="180" width="8" height="40" />
      </g>

      <g class="piece" data-n="2" data-etat={p(2).etat} style={st(2)}>
        <ellipse class="c" cx="166" cy="200" rx="5" ry="22" />
        <ellipse class="c" cx="166" cy="200" rx="2" ry="10" />
      </g>

      <g class="piece" data-n="3" data-etat={p(3).etat} style={st(3)}>
        <rect class="c" x="174" y="182" width="6" height="36" />
        <path class="c" d="M180 188L198 172V228L180 212Z" />
        <rect class="c" x="196" y="165" width="80" height="70" rx="14" />
        <path class="c" d="M276 172L294 188V212L276 228Z" />
        <path class="fin" d="M212 168V232M260 168V232" />
        <path class="cache" d="M200 200H272" />
      </g>

      <g class="piece" data-n="4" data-etat={p(4).etat} style={st(4)}>
        <rect class="c" x="296" y="190" width="64" height="20" />
        <path class="fin" d={Array.from({ length: 11 }, (_, i) => `M${302 + i * 5.2} 191V209`).join('')} />
      </g>

      <g class="piece" data-n="5" data-etat={p(5).etat} style={st(5)}>
        <path class="to" d="M362 200H434" /><path class="ti" d="M362 200H434" />
        <rect class="c" x="432" y="176" width="90" height="48" rx="22" />
        <path class="cache" d="M440 200H514" />
        <path class="to" d="M522 200H598" /><path class="ti" d="M522 200H598" />
      </g>

      <g class="piece" data-n="6" data-etat={p(6).etat} style={st(6)}>
        <rect class="c" x="600" y="186" width="12" height="28" rx="2" />
        <rect class="c" x="602" y="176" width="8" height="10" />
        <path class="fin" d="M606 170V176" />
      </g>

      <g class="piece" data-n="7" data-etat={p(7).etat} style={st(7)}>
        <path class="to" d="M614 200H652" /><path class="ti" d="M614 200H652" />
        <rect class="c" x="650" y="152" width="150" height="96" rx="30" />
        <path class="cache" d="M700 160V240M750 160V240" />
        <path class="to" d="M800 200L852 194" /><path class="ti" d="M800 200L852 194" />
        <ellipse class="c" cx="854" cy="194" rx="4" ry="9" />
      </g>

      <g class="piece" data-n="8" data-etat={p(8).etat} style={st(8)}>
        <path class="fin" d="M725 108V121M725 139V151" />
        <rect class="c" x="720" y="104" width="10" height="5" />
        <ellipse class="c caoutchouc" cx="725" cy="130" rx="15" ry="9" />
      </g>

      <g class="repere" aria-hidden="true">
        {PIECES.map((x) => (
          <g data-r={x.n}>
            {x.n === 8
              ? <path class="guide" d={`M806 62L${x.cx - 14} 46`} />
              : <path class="guide" d={x.ly < 200 ? `M${x.cx} ${x.ly + 14}V${x.py}` : `M${x.cx} ${x.py}V${x.ly - 14}`} />}
            <circle class="bulle" cx={x.cx} cy={x.ly} r="14" />
            <text x={x.cx} y={x.ly + 5} text-anchor="middle">{x.n}</text>
          </g>
        ))}
      </g>
    </svg>
  </div>
  <p class="sm:hidden px-4 py-2 text-[.85rem] text-gris border-t border-trait">Faites glisser le dessin pour voir toute la ligne.</p>
  <figcaption class="border-t-2 border-anthracite grid md:grid-cols-[1fr_15rem]">
    <ol class="grid sm:grid-cols-2 text-[.95rem]">
      {PIECES.map((x) => (
        <li class="repere-item flex items-center gap-3 px-4 py-2.5 border-b border-trait sm:odd:border-r" data-l={x.n}>
          <span class="font-titre font-bold w-6 text-right flex-none">{x.n}</span>
          <span class="flex-1">{x.nom}</span>
          <span class:list={['etat flex items-center gap-1.5 text-[.85rem] font-semibold whitespace-nowrap', `etat-${x.etat}`]}>
            <span class="pastille-etat" aria-hidden="true"></span>{ETATS[x.etat]}
          </span>
        </li>
      ))}
    </ol>
    <div class="px-4 py-3 md:border-l-2 border-anthracite text-[.88rem] leading-snug bg-papier">
      <p class="font-titre font-bold text-[1rem]">Planche 1</p>
      <p>Ligne d'échappement, vue éclatée.</p>
      <p class="mt-2 text-gris">Dessin d'illustration : il montre la méthode, pas le dossier d'un client.</p>
    </div>
  </figcaption>
</figure>

<style>
  svg { --plan: #3d6e9e; --orange: #e2601b; --orange-fonce: #ae4510; }
  .c { fill: #fff; stroke: var(--plan); stroke-width: 2; stroke-linejoin: round; }
  .to { fill: none; stroke: var(--plan); stroke-width: 16; }
  .ti { fill: none; stroke: #fff; stroke-width: 12; }
  .fin { fill: none; stroke: var(--plan); stroke-width: 1.4; }
  .cache { fill: none; stroke: var(--plan); stroke-width: 1.2; stroke-dasharray: 6 4; }
  .caoutchouc { stroke-width: 5; fill: none; }
  [data-etat='remplace'] .c { fill: url(#hachures); stroke: var(--orange-fonce); }
  [data-etat='remplace'] .to { stroke: var(--orange-fonce); }
  [data-etat='remplace'] .ti { stroke: url(#hachures); }
  [data-etat='remplace'] .fin { stroke: var(--orange-fonce); }
  [data-etat='surveille'] .c { stroke: var(--orange-fonce); stroke-dasharray: 5 3; }
  [data-etat='surveille'] .fin { stroke: var(--orange-fonce); }
  .guide { stroke: #2a2d31; stroke-width: 1; fill: none; }
  .bulle { fill: #fff; stroke: #2a2d31; stroke-width: 2; }
  .repere text { font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 15px; fill: #2a2d31; }
  .piece.actif .c, .piece.actif .fin { stroke-width: 3; }
  .repere g.actif .bulle { fill: var(--orange); }
  .repere-item.actif { background: color-mix(in srgb, var(--color-orange) 12%, #fff); }

  .pastille-etat { width: .85rem; height: .85rem; border: 2px solid currentColor; flex: none; }
  .etat-garde { color: var(--color-plan); }
  .etat-remplace { color: var(--color-orange-fonce); }
  .etat-remplace .pastille-etat { background: repeating-linear-gradient(45deg, var(--color-orange) 0 2px, #fdeee5 2px 4px); }
  .etat-surveille { color: var(--color-orange-fonce); }
  .etat-surveille .pastille-etat { border-style: dashed; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-eclate]').forEach((fig) => {
    const ouvrir = () => fig.classList.add('ouverte');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { ouvrir(); io.disconnect(); } }, { threshold: 0.3 });
      io.observe(fig);
    } else ouvrir();
    const marquer = (n: string | undefined, on: boolean) => {
      if (!n) return;
      fig.querySelectorAll(`[data-n="${n}"], [data-r="${n}"], [data-l="${n}"]`).forEach((el) => el.classList.toggle('actif', on));
    };
    fig.querySelectorAll<HTMLElement | SVGElement>('[data-l], .piece').forEach((el) => {
      const n = el.dataset.l ?? el.dataset.n;
      el.addEventListener('pointerenter', () => marquer(n, true));
      el.addEventListener('pointerleave', () => marquer(n, false));
    });
  });
</script>
