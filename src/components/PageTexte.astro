---
import Base from '../layouts/Base.astro';
interface Props { title: string; description: string; titre: string; noindex?: boolean }
const { title, description, titre, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="bg-papier border-b-2 border-anthracite">
    <div class="wrap py-12 md:py-16">
      <h1 class="text-[2.3rem] md:text-[3.2rem]">{titre}</h1>
    </div>
  </div>
  <div class="wrap py-12 md:py-16">
    <div class="texte max-w-[44rem]">
      <slot />
    </div>
  </div>
</Base>
<style>
  .texte :global(h2) { font-size: 1.5rem; margin-top: 2.4rem; margin-bottom: .6rem; }
  .texte :global(p), .texte :global(ul) { margin-top: .7rem; }
  .texte :global(ul) { list-style: square; padding-left: 1.3rem; }
  .texte :global(a) { text-decoration: underline; font-weight: 600; }
</style>
