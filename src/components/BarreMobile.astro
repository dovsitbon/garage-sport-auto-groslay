---
import { SITE } from '../data/site';
---
<div class="md:hidden fixed inset-x-0 bottom-0 z-30 bg-anthracite grid grid-cols-[1fr_auto] gap-2 p-2.5 pb-[max(.625rem,env(safe-area-inset-bottom))] sombre">
  <a href={`tel:${SITE.telLien}`} class="btn btn-orange whitespace-nowrap !px-3">Appeler le {SITE.telAffiche}</a>
  <a href={SITE.itineraire} class="btn btn-ligne !px-4" target="_blank" rel="noopener">Itinéraire</a>
</div>
